# Copy this file to .env and fill in real values. Never commit .env.
#
# All provider keys are optional for local dev: SUL_PROVIDER defaults to
# "fake", which needs no key and reads/writes tests/cassettes/. The full
# test suite must pass with none of the *_API_KEY values set.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Which provider the runner uses by default: fake | anthropic | openai | gemini
SUL_PROVIDER=fake

# SQLAlchemy connection string.
SUL_DATABASE_URL=sqlite:///sul.db

# Standard library logging level.
SUL_LOG_LEVEL=INFO

# Set to 1 to record real provider responses into tests/cassettes/ instead of
# replaying them. Never set this in CI.
RECORD=0
