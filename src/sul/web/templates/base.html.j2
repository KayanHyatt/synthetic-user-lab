<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{% block title %}Synthetic User Lab{% endblock %}</title>
<script src="/static/{{ htmx_filename }}"></script>
<style>
  body { font-family: system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; background: #fff; }
  nav a { margin-right: 1rem; }
  .caveat { border: 1px solid #b58900; background: #fff8e1; padding: 0.75rem 1rem; border-radius: 4px; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; }
  table td, table th { border: 1px solid #ccc; padding: 0.25rem 0.5rem; text-align: left; }
  .status-completed { color: #1a7a1a; }
  .status-failed { color: #b00; }
  .status-pending, .status-running { color: #888; }
  pre.quote { white-space: pre-wrap; word-wrap: break-word; background: #f6f6f6; padding: 0.5rem; border-radius: 4px; }
  .transcript-turn { border-left: 3px solid #ccc; margin: 0.5rem 0; padding-left: 0.75rem; }
  .turn-moderator { border-left-color: #6699cc; }
  .turn-persona { border-left-color: #66aa66; }
</style>
</head>
<body>
<nav><a href="/">Studies</a></nav>
<h1>{% block heading %}Synthetic User Lab{% endblock %}</h1>
{# The standing caveat: outside every hx-target this app declares, and
   never inside a block a partial swap could replace
   (PROJECT_SPEC.md §M7: "can any HTMX swap replace or hide the region
   carrying it?" -- tested structurally in tests/test_web_caveat.py). #}
<p class="caveat" id="standing-caveat">{{ caveat }}</p>
{% block content %}{% endblock %}
</body>
</html>
